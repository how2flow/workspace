#!/bin/sh

WORK_PATH=${PWD}
IDIR_PATH=${WORK_PATH}/idir
AUTH_FILE=$HOME/.coverity/authkeys/ak-coverity.telechips.com-8443
COV_HOST="https://coverity.telechips.com:8443"


ALL_DEFECT_CNT=0

function csv_to_markdown_type3() {
	local INPUT_CSV="$1"
	local OUTPUT_MARK="$2"

	# Create the Markdown table header
	echo "| No | Module | File | Rule Violation | Count | Justification | Line Number | 테스트 결함(TCS Link) | 비고 |" > ${OUTPUT_MARK}
	echo "|----|--------|------|----------------|-------|---------------|-------------|-----------------------|------|" >> ${OUTPUT_MARK}

	# Read the CSV file and process items with the same mergeKey
	# $1: mergeKey
	# $2: File
	# $3: Rule Violation
	# $4: Line Number
	# $5: Summary
	# $6: Detailed Description
	# $7: cid
	awk -F',' -v FPAT='[^,]*|"[^"]*"' -v module="${MODULE}" '{
		if (NR > 1) {
			gsub("\"", "", $2);
			gsub("\"", "", $3);
			gsub("\"", "", $4);
			gsub("\"", "", $5);
			gsub(/\|/, "\\|", $5);
			gsub("\"", "", $6);
			gsub(/\*/, "\\*", $6);
			gsub(/\|/, "\\|", $6);
			gsub("\"", "", $7);

			if (!defect_idx[$1]) {
				uniq_idx++;
				defect_idx[$1] = uniq_idx;
				file[uniq_idx] = $2;
				rule[uniq_idx] = $3;
				count[uniq_idx] = 1;
				description[uniq_idx] = $2 ":" $4 ":<br>" $6;
				line_numbers[uniq_idx] = $4;
				cid[uniq_idx] = "CID:" $7
			} else {
				count[defect_idx[$1]]++;
				description[defect_idx[$1]] = description[defect_idx[$1]] "<br>" $2 ":" $4 ":<br>" $6;
				line_numbers[defect_idx[$1]] = line_numbers[defect_idx[$1]] ", " $4;
			}
		} else {
			uniq_idx = 0;
		}
	} END {
		for (idx in file) {
			printf "| %d | %s | %s | %s | %d | **Detailed Description** <br> %s <br><br> **Justification** <br><br> | %s | - | %s |\n", idx, module, file[idx], rule[idx], count[idx], description[idx], line_numbers[idx], cid[idx];
		}
	}' "${INPUT_CSV}" >> "${OUTPUT_MARK}"

	DEFECT_CNT=$(tail -n +2 "${INPUT_CSV}" | wc -l)
	ALL_DEFECT_CNT=$((ALL_DEFECT_CNT + DEFECT_CNT))
	echo "[INFO] Make ${OUTPUT_MARK}" ... Total Count: "${DEFECT_CNT}"
}

